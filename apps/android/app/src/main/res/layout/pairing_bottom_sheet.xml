<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pairing_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pairing_sheet_title"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/laymux_on_surface_variant" />

        <TextView
            android:id="@+id/pairing_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/laymux_surface_variant"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/laymux_primary"
            tools:text="페어링 확인됨" />

        <TextView
            android:id="@+id/pairing_state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/laymux_on_surface"
            tools:text="데스크톱과 키를 서로 확인했습니다" />

        <TextView
            android:id="@+id/pairing_state_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_on_surface_variant"
            tools:text="암호키는 Android Keystore로 보호됩니다." />

        <TextView
            android:id="@+id/pairing_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_error"
            android:visibility="gone"
            tools:text="연결 오류"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/pairing_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_notice"
            android:visibility="gone"
            tools:text="연결 안내"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/pairing_remote_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/laymux_surface_variant"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pairing_remote_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/laymux_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/pairing_remote_description"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/laymux_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairing_connect_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pairing_connect" />
        </LinearLayout>

        <!-- 16dp side margins match the remote section's inner padding so this
             button and the connect button inside the card share one width. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_scan_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:text="@string/pairing_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_paste_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text="@string/pairing_paste" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairing_cancel_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:text="@string/pairing_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
