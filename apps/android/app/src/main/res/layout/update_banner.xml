<?xml version="1.0" encoding="utf-8"?>
<!--
  업데이트 배너 (ADR-0197). 후보가 있을 때만 화면 상단에 뜨고, 기본 동작은
  릴리스 페이지 열기, 보조 동작은 그 버전 닫기다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/update_banner_background"
    android:clickable="true"
    android:focusable="true"
    android:elevation="6dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/update_banner_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/laymux_on_surface"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/update_banner_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/laymux_on_surface_variant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_banner_dismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_banner_dismiss" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_banner_open"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/update_banner_open" />
    </LinearLayout>
</LinearLayout>
