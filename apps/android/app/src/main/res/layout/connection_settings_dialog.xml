<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/connection_settings_device_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/laymux_on_surface"
            tools:text="개발 PC" />

        <TextView
            android:id="@+id/connection_settings_instance_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/laymux_on_surface_variant"
            tools:text="desktop-a" />

        <TextView
            android:id="@+id/connection_settings_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/laymux_on_surface_variant"
            tools:text="https://app.laymux.com/" />

        <TextView
            android:id="@+id/connection_settings_pairing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/laymux_surface_variant"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/laymux_primary"
            tools:text="페어링 확인됨" />

        <TextView
            android:id="@+id/connection_settings_pairing_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connection_settings_not_paired"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_on_surface_variant"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/connection_settings_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_error"
            android:visibility="gone"
            tools:text="연결 설정 오류"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/connection_settings_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/laymux_notice"
            android:visibility="gone"
            tools:text="설정을 변경했습니다."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/connection_settings_pairing_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connection_settings_retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pairing_retry_confirmation" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connection_settings_verify"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pairing_verify_protection" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connection_settings_forget"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pairing_forget"
                android:textColor="@color/laymux_error" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/connection_settings_biometric_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pairing_protection_title"
            android:textColor="@color/laymux_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pairing_protection_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/laymux_on_surface_variant" />

        <TextView
            android:id="@+id/connection_settings_biometric_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/laymux_on_surface_variant"
            tools:text="기본값 · PIN이나 패턴으로 자동 대체하지 않습니다." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
