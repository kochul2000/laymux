{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "floatingEnabled": {
      "type": "boolean",
      "default": true,
      "applyMode": "live",
      "description": "플로팅 컨트롤 전체 표시 스위치. false는 모든 패드·버튼을 숨기되 개별 활성·크기·위치를 보존합니다. true는 구성된 항목을 다시 표시합니다. 최초에는 패드가 모두 꺼져 있으므로 방향 패드를 요청하면 floatingDpadEnabled도 켜세요."
    },
    "floatingDpadEnabled": {
      "type": "boolean",
      "default": false,
      "applyMode": "live",
      "description": "커서 방향키 플로팅 패드. 표시에는 floatingEnabled=true도 필요합니다."
    },
    "floatingNavPadEnabled": {
      "type": "boolean",
      "default": false,
      "applyMode": "live",
      "description": "pane·알림 탐색 플로팅 패드. 표시에는 floatingEnabled=true도 필요합니다."
    },
    "floatingDpadSize": {
      "type": "number",
      "default": 64,
      "minimum": 44,
      "maximum": 128,
      "applyMode": "live",
      "description": "커서 방향키 플로팅 패드 크기(CSS px)."
    },
    "floatingNavPadSize": {
      "type": "number",
      "default": 64,
      "minimum": 44,
      "maximum": 128,
      "applyMode": "live",
      "description": "pane·알림 플로팅 패드 크기(CSS px)."
    },
    "floatingDpadOpacity": {
      "type": "number",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "커서 방향키 플로팅 패드 불투명도. 0~1 비율이며 50%는 0.5입니다."
    },
    "floatingNavPadOpacity": {
      "type": "number",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "pane·알림 플로팅 패드 불투명도. 0~1 비율입니다."
    },
    "terminalFontSize": {
      "type": "integer",
      "description": "이 Remote 기기의 터미널 글자 크기(px). PC 터미널 크기는 바꾸지 않습니다.",
      "default": 14,
      "minimum": 6,
      "maximum": 72,
      "group": "display",
      "applyMode": "live"
    },
    "composerFontSize": {
      "type": "integer",
      "description": "Remote 입력창(Composer) 글자 크기(px).",
      "default": 16,
      "minimum": 6,
      "maximum": 72,
      "group": "display",
      "applyMode": "live"
    },
    "menuFontSize": {
      "type": "integer",
      "description": "Remote 메뉴·버튼 글자 크기(px).",
      "default": 13,
      "minimum": 6,
      "maximum": 72,
      "group": "display",
      "applyMode": "live"
    },
    "navigationPinned": {
      "type": "boolean",
      "description": "넓은 화면에서 탐색 패널을 고정합니다.",
      "default": false,
      "group": "display",
      "applyMode": "live"
    },
    "navigationWidth": {
      "type": "integer",
      "description": "고정 탐색 패널 너비(px).",
      "default": 360,
      "minimum": 200,
      "maximum": 720,
      "group": "display",
      "applyMode": "live"
    },
    "navigationPinCutoff": {
      "type": "integer",
      "description": "탐색 패널 고정을 허용하는 최소 화면 너비(px).",
      "default": 720,
      "minimum": 320,
      "maximum": 2560,
      "group": "display",
      "applyMode": "live"
    },
    "composerIdleOpacity": {
      "type": "integer",
      "description": "입력창이 비활성일 때 불투명도(%). idle ≤ focused ≤ active를 유지하세요.",
      "default": 55,
      "minimum": 20,
      "maximum": 100,
      "group": "display",
      "applyMode": "live"
    },
    "composerFocusedOpacity": {
      "type": "integer",
      "description": "입력창에 포커스가 있을 때 불투명도(%).",
      "default": 80,
      "minimum": 20,
      "maximum": 100,
      "group": "display",
      "applyMode": "live"
    },
    "composerActiveOpacity": {
      "type": "integer",
      "description": "입력 중인 입력창의 불투명도(%).",
      "default": 100,
      "minimum": 20,
      "maximum": 100,
      "group": "display",
      "applyMode": "live"
    },
    "snapshotMaxKib": {
      "type": "integer",
      "description": "최초 출력·스크롤 기록 가져오기 예산(KiB). 다음 terminal attach부터 적용됩니다.",
      "default": 4,
      "minimum": 1,
      "maximum": 1024,
      "applyMode": "nextUse",
      "group": "display"
    },
    "scrollSensitivity": {
      "type": "number",
      "description": "Remote 마우스 휠 스크롤 배율. 현재보다 두 배는 현재 값 × 2입니다.",
      "default": 1,
      "minimum": 0.1,
      "maximum": 20,
      "group": "display",
      "applyMode": "live"
    },
    "fastScrollSensitivity": {
      "type": "number",
      "description": "Remote Alt+휠 스크롤 배율.",
      "default": 5,
      "minimum": 0.1,
      "maximum": 20,
      "group": "display",
      "applyMode": "live"
    },
    "touchScrollSensitivity": {
      "type": "number",
      "description": "Remote 한 손가락 터치 스크롤 배율.",
      "default": 1,
      "minimum": 0.1,
      "maximum": 20,
      "group": "display",
      "applyMode": "live"
    },
    "twoFingerScrollSensitivity": {
      "type": "number",
      "description": "Remote 두 손가락 터치 스크롤 배율.",
      "default": 5,
      "minimum": 0.1,
      "maximum": 20,
      "group": "display",
      "applyMode": "live"
    },
    "inputMode": {
      "type": "string",
      "enum": ["direct", "composer"],
      "default": "direct",
      "description": "현재 Remote 입력 모드. direct는 직접 터미널 입력, composer는 별도 입력창입니다.",
      "applyMode": "live"
    },
    "composerHistoryPopup": {
      "type": "boolean",
      "description": "Tab 키로 과거 입력 선택창을 엽니다. 입력 내용은 조회·저장하지 않습니다.",
      "default": true,
      "applyMode": "live"
    },
    "composerAutocomplete": {
      "type": "boolean",
      "description": "입력 중 과거 입력 자동완성을 표시합니다.",
      "default": true,
      "applyMode": "live"
    },
    "composerHideAgentInput": {
      "type": "boolean",
      "description": "Composer 모드에서 에이전트의 원래 입력 영역을 숨깁니다.",
      "default": true,
      "applyMode": "live"
    },
    "composerHistoryScope": {
      "type": "string",
      "enum": ["global", "workspace", "pane"],
      "default": "global",
      "description": "과거 입력을 공유할 범위: 전체, 워크스페이스, pane. 내용 자체는 메모리 전용입니다.",
      "applyMode": "live"
    },
    "widgetStrip": {
      "type": "boolean",
      "description": "이 기기의 위젯 바 표시. PC remote.widgets 공개 정책도 켜져 있어야 보입니다.",
      "default": true,
      "applyMode": "live"
    },
    "edgeSwipeDrawers": {
      "type": "boolean",
      "description": "화면 가장자리 스와이프로 패널을 엽니다.",
      "default": true,
      "applyMode": "live"
    },
    "swipeCloseDrawers": {
      "type": "boolean",
      "description": "스와이프로 열린 패널을 닫습니다.",
      "default": true,
      "applyMode": "live"
    },
    "composerHiddenClaudeLines": {
      "type": "integer",
      "default": 3,
      "minimum": 0,
      "maximum": 24,
      "applyMode": "live",
      "description": "Claude 원래 입력영역에서 숨길 줄 수. composerHideAgentInput이 켜진 Composer에서 적용."
    },
    "composerHiddenCodexLines": {
      "type": "integer",
      "default": 4,
      "minimum": 0,
      "maximum": 24,
      "applyMode": "live",
      "description": "Codex 원래 입력영역에서 숨길 줄 수. composerHideAgentInput이 켜진 Composer에서 적용."
    },
    "composerHiddenGrokLines": {
      "type": "integer",
      "default": 2,
      "minimum": 0,
      "maximum": 24,
      "applyMode": "live",
      "description": "Grok 원래 입력영역에서 숨길 줄 수. composerHideAgentInput이 켜진 Composer에서 적용."
    },
    "floatingDpadX": {
      "type": "number",
      "default": 0.95,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "커서 방향키 플로팅 패드 X 위치. 가용 화면 정규화 좌표0~1. X=왼쪽에서 오른쪽, Y=위에서 아래."
    },
    "floatingDpadY": {
      "type": "number",
      "default": 0.65,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "커서 방향키 플로팅 패드 Y 위치. 가용 화면 정규화 좌표0~1. X=왼쪽에서 오른쪽, Y=위에서 아래."
    },
    "floatingNavPadX": {
      "type": "number",
      "default": 0.05,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "pane·알림 플로팅 패드 X 위치. 가용 화면 정규화 좌표0~1. X=왼쪽에서 오른쪽, Y=위에서 아래."
    },
    "floatingNavPadY": {
      "type": "number",
      "default": 0.65,
      "minimum": 0,
      "maximum": 1,
      "applyMode": "live",
      "description": "pane·알림 플로팅 패드 Y 위치. 가용 화면 정규화 좌표0~1. X=왼쪽에서 오른쪽, Y=위에서 아래."
    },
    "inputBarZones": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "expanded"],
      "properties": {
        "main": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "center", "right"],
          "properties": {
            "left": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "center": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "right": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "expanded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "center", "right"],
          "properties": {
            "left": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "center": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "right": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      },
      "default": {
        "main": {
          "left": ["soft:c-c", "soft:q", "soft:esc"],
          "center": [],
          "right": ["keyboard", "keys", "send"]
        },
        "expanded": {
          "left": ["composer", "soft:navPad", "soft:tab", "soft:stab"],
          "center": [],
          "right": [
            "soft:c-u",
            "soft:c-l",
            "soft:c-t",
            "soft:c-j",
            "soft:dpad",
            "soft:pgup",
            "soft:pgdn",
            "attachment"
          ]
        }
      },
      "applyMode": "live",
      "description": "입력바 행·정렬·순서 객체 전체 교체: 현재 값을 읽고 다른 배치를 보존하세요. main/expanded 각 left/center/right 배열에 액션 ID 배치. 숨기기는 모든 배열에서 제거. 같은 액션은 한 곳에만, keys 토글은 main에만. 내장 ID는 schema.actionCatalog, 사용자 키는 soft:<userKeys.id>."
    },
    "inputBarUserKeys": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "seq"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 26,
            "pattern": "^u-[a-z0-9]{1,24}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "seq": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      },
      "default": [],
      "applyMode": "live",
      "description": "사용자 등록 특수키 목록 전체 교체. id=u-영소문자숫자, label=양끝공백 없는1~8자, seq=실제 전송 문자열 최대32자. 저장만 하고 실행하지 않음. 삭제 시 inputBarZones와 floatingButtons 참조도 함께 제거. 입력 초안·기록은 포함하지 않음."
    },
    "floatingButtons": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actionId", "enabled", "size", "opacity", "x", "y"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 52,
            "pattern": "^f-[a-z0-9-]{1,50}$"
          },
          "actionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "enabled": {
            "type": "boolean"
          },
          "size": {
            "type": "number",
            "minimum": 44,
            "maximum": 128
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "default": [],
      "applyMode": "live",
      "description": "일반 플로팅 버튼 목록 전체 교체. 기존 항목을 보존하고 고유 f- ID로 추가. 액션은 schema.actionCatalog 또는 soft:<사용자키id>. soft:dpad/navPad는 전용 패드 설정 사용. 같은 액션 여러 버튼 허용. enabled와 floatingEnabled 모두 true여야 표시. size=px, opacity/x/y=0~1."
    },
    "spatialExcludedPaneIds": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "default": [],
      "uniqueItems": true,
      "applyMode": "live",
      "description": "이 기기에서 순회 탐색에서 제외할 Pane ID 목록 전체 교체. list_workspaces/get_active_workspace로 실제 ID를 확인. 워크스페이스 제외와 그 안의 모든 터미널 pane 제외가 일치하도록 두 목록을 함께 변경."
    },
    "spatialExcludedWorkspaceIds": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "default": [],
      "uniqueItems": true,
      "applyMode": "live",
      "description": "이 기기에서 순회 탐색에서 제외할 Workspace ID 목록 전체 교체. list_workspaces/get_active_workspace로 실제 ID를 확인. 워크스페이스 제외와 그 안의 모든 터미널 pane 제외가 일치하도록 두 목록을 함께 변경."
    },
    "mainButtonScale": {
      "type": "integer",
      "enum": [80, 90, 100, 110, 120, 130, 140, 150, 160],
      "default": 100,
      "applyMode": "live",
      "description": "기본 입력행 버튼 크기 배율(%). 80~160, 10 단위."
    },
    "keysButtonScale": {
      "type": "integer",
      "enum": [80, 90, 100, 110, 120, 130, 140, 150, 160],
      "default": 100,
      "applyMode": "live",
      "description": "Keys 확장행 버튼 크기 배율(%). 80~160, 10 단위."
    },
    "selectionHandleSize": {
      "type": "integer",
      "minimum": 14,
      "maximum": 32,
      "default": 22,
      "applyMode": "live",
      "description": "터미널 텍스트 선택 핸들 크기(px), 14~32."
    }
  },
